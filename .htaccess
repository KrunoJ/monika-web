# Clean URLs + one canonical host so cookie consent is remembered
<IfModule mod_rewrite.c>
  RewriteEngine On

  # www → apex (same site, one localStorage / cookie origin)
  RewriteCond %{HTTP_HOST} ^www\.monikajagic\.com$ [NC]
  RewriteRule ^ https://monikajagic.com%{REQUEST_URI} [R=301,L]

  # Meetup ticket API (Embedded Checkout)
  RewriteRule ^api/meetup/ticket-status/?$ api/meetup/ticket-status.php [L,QSA]
  RewriteRule ^api/meetup/create-checkout/?$ api/meetup/create-checkout.php [L,QSA]
  RewriteRule ^api/meetup/webhook/?$ api/meetup/webhook.php [L,QSA]

  # /index.html → /
  # /biznis-okvir/index.html → /biznis-okvir/
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]
</IfModule>
